{
  "name": "aleph-garden-www",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "fonts": "rm -rf public/fonts && cp -R node_modules/@aleph-garden/brand/fonts public/fonts",
    "dev": "bun run fonts && astro dev",
    "dev:host": "bun run fonts && vite host",
    "build": "bun run fonts && vite build host && astro build && cp -R host/dist/. dist/",
    "preview": "astro preview",
    "check": "astro check",
    "test": "bun test",
    "deploy": "wrangler pages deploy dist --project-name=aleph-garden --branch=main"
  },
  "dependencies": {
    "@aleph-garden/brand": "0.1.3-dev",
    "@aleph-garden/host-core": "0.3.2-dev",
    "@aleph-garden/starlight-theme": "workspace:*",
    "@aleph-garden/terms": "0.3.2-dev",
    "@aleph-garden/vitrine": "0.3.2-dev",
    "@aleph-garden/vitrine-jsonld": "0.3.2-dev",
    "@aleph-garden/vitrine-turtle": "0.3.2-dev",
    "@astrojs/starlight": "^0.42.1",
    "astro": "^7.3.3",
    "astro-mermaid": "^2.1.0",
    "mermaid": "^12.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "^1.4.2",
    "shiki": "4.4.3",
    "typescript": "^6",
    "vite": "^8.3.0",
    "wrangler": "^4.133.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
