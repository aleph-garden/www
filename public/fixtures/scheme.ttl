# The subjects the claim points at. A separate resource, so a view that wants
# their labels crosses a resource boundary to get them.

@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

<#scheme> a skos:ConceptScheme ;
  schema:name "How a store is read"@en .

<#resolvable-identifier> a skos:Concept ;
  skos:inScheme <#scheme> ;
  skos:prefLabel "Resolvable identifier"@en ;
  skos:scopeNote "A name that answers when it is fetched, so the identifier and the data are one address."@en ;
  rdfs:seeAlso <https://www.w3.org/DesignIssues/LinkedData.html> .

<#content-negotiation> a skos:Concept ;
  skos:inScheme <#scheme> ;
  skos:broader <#resolvable-identifier> ;
  skos:prefLabel "Content negotiation"@en ;
  skos:scopeNote "One address, several representations, and the request says which one it wants."@en ;
  rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc9110#name-content-negotiation> .

<#rule-table> a skos:Concept ;
  skos:inScheme <#scheme> ;
  skos:prefLabel "Rule table"@en ;
  skos:scopeNote "An ordered list that maps what a resource is to the code that draws it, so the drawing is replaceable without touching the reader."@en .
