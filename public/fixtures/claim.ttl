# One resource, the shape a reader of this page already has: a subject with a
# label and typed literals, and references out to subjects that live in
# another resource. The page shows the code that draws it.

@prefix schema: <https://schema.org/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

<> a schema:Claim ;
  schema:name "Why a store needs no client"@en ;
  schema:text """A store that answers at every resource's own IRI needs no client of its own.
What a reader sees is decided by the rules that draw the resource, not by the
application that fetched it."""@en ;
  schema:dateCreated "2026-09-22T14:02:00Z"^^xsd:dateTime ;
  prov:wasAttributedTo <https://github.com/tophcodes> ;
  schema:about <scheme.ttl#resolvable-identifier> ,
               <scheme.ttl#content-negotiation> ,
               <scheme.ttl#rule-table> .
