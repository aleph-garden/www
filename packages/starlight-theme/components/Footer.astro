---
// Starlight's own footer row (pagination), then the site footer, whose
// markup comes from footer.js so the landing page draws the same one. The
// edit link moves into the site footer, so Starlight's is not rendered.
import Pagination from 'virtual:starlight/components/Pagination'
import { footer } from '../footer.js'
import light from '../brand/lockup-horizontal-short-light.svg'
import dark from '../brand/lockup-horizontal-short-dark.svg'

const { editUrl } = Astro.locals.starlightRoute
const html = footer({ lockup: { light: light.src, dark: dark.src }, editUrl: editUrl?.href })
---

<Pagination />
<Fragment set:html={html} />
