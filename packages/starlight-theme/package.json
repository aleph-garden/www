{
  "name": "@aleph-garden/starlight-theme",
  "version": "0.1.1-dev",
  "description": "The Aleph Garden theme for Starlight: tokens, faces, the project switcher and the site footer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleph-garden/www.git",
    "directory": "packages/starlight-theme"
  },
  "homepage": "https://aleph.garden",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./footer": {
      "types": "./footer.d.ts",
      "default": "./footer.js"
    },
    "./theme": {
      "types": "./theme.d.ts",
      "default": "./theme.js"
    },
    "./starlight.css": "./starlight.css",
    "./footer.css": "./footer.css",
    "./components/*": "./components/*"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "footer.js",
    "footer.d.ts",
    "last-edited.js",
    "theme.js",
    "theme.d.ts",
    "virtual.d.ts",
    "*.css",
    "components"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "dev"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.42.0"
  },
  "dependencies": {
    "@aleph-garden/brand": "0.1.1-dev"
  }
}
